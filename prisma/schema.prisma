// Prisma 7 schema. Client is generated to src/generated/prisma (see prisma.config.ts).
// Runtime uses the @prisma/adapter-pg driver adapter against Supabase Postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  email     String    @unique
  password  String
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]

  @@map("users")
}

// Refresh-token family for rotation + reuse detection (RFC 8725 §5).
// We store only a hash of the refresh token, never the token itself.
model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti         String    @unique
  hashedToken String
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

enum ProjectKind {
  INTERNAL_DEMO // lives inside this app
  EXTERNAL_LIVE // hosted elsewhere, linked + auto-thumbnailed
  NATIVE_APP    // Swift / on-device CoreAI apps, shown via video + screenshots
  AI_SYSTEM     // the live AI features built into this site
}

enum MediaType {
  IMAGE
  VIDEO
}

enum LeadStatus {
  PENDING
  REFERRED
}

model Project {
  id        String      @id @default(uuid())
  slug      String      @unique
  title     String
  summary   String
  longform  String? // markdown long-form write-up
  kind      ProjectKind
  tags      String[]
  repoUrl   String?
  liveUrl   String?
  thumbnailUrl String?
  featured  Boolean     @default(false)
  order     Int         @default(0)
  published Boolean     @default(true)
  // The "explain everything" hover cards: technical vs plain-language.
  explainerTech  String?
  explainerPlain String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  media     Media[]

  @@index([kind])
  @@map("projects")
}

model Media {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  caption   String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([projectId])
  @@map("media")
}

model Lead {
  id           String     @id @default(uuid())
  leadName     String
  service      String
  location     String
  partner      String?
  status       LeadStatus @default(PENDING)
  discountCode String?
  createdAt    DateTime   @default(now())

  @@map("leads")
}

// Resume-style education. endYear null (or current=true) means ongoing.
model Education {
  id          String   @id @default(uuid())
  school      String
  credential  String // degree, certificate, or program
  field       String?
  startYear   Int
  endYear     Int?
  current     Boolean  @default(false)
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("education")
}

// Skills, grouped by a free-text category (Languages, AI & Tooling, etc.).
model Skill {
  id        String   @id @default(uuid())
  name      String
  category  String
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category])
  @@map("skills")
}
